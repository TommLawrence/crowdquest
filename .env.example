# Local application defaults. Keep this file free of credentials.
PORT=3000
HOST=127.0.0.1
DATA_DIR=.data

# Local Node Twitch WebSocket mode. Leave blank until Twitch credentials are ready.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Vercel OAuth roles and production EventSub webhook.
TWITCH_BOT_REDIRECT_URI=https://your-domain.example/api/twitch/bot/callback
TWITCH_EVENTSUB_SECRET=

# Vercel API to Convex server-to-server access. Generate a random secret of at least 32 characters.
CONVEX_SERVICE_SECRET=

# Convex deployment URLs and CLI configuration. Convex CLI can generate CONVEX_DEPLOYMENT.
CONVEX_URL=
CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

# Public browser setting. It contains only the Convex deployment URL, never a credential.
VITE_CONVEX_URL=

# Local-only demo controls. This never enables production simulation.
SIMULATED_CHAT_ENABLED=false
